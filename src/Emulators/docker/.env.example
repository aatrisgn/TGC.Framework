# Copy this file to .env in the same folder and fill in the values below.
# .env is gitignored since it holds the SQL Edge SA password.

# Pass 'Y' to accept the license terms for SQL Edge, the Service Bus emulator,
# and the Event Hubs emulator. See:
#   https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
#   https://github.com/Azure/azure-event-hubs-emulator-installer/blob/main/EMULATOR_EULA.md
ACCEPT_EULA=N

# SA password for the sqledge container backing the Service Bus emulator.
# Must satisfy SQL Server's strong password policy (upper/lower/digit/symbol, 8+ chars).
MSSQL_SA_PASSWORD=
