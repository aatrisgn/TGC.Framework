# Throwaway Docker-in-Docker image for running the Emulators unit tests
# end-to-end (compose stack + dotnet test) inside a single container, without
# touching the host's Docker. Local experiment only — see README.md.
#
# Build:
#   docker build -f src/Emulators/docker/Dockerfile.dind -t tgc-emulators-dind src/Emulators/docker
# Run (needs --privileged for the nested dockerd):
#   docker run --rm --privileged tgc-emulators-dind
FROM ubuntu:26.04

ARG GIT_REF=main
ARG DOTNET_CHANNEL=10.0

ENV DEBIAN_FRONTEND=noninteractive \
    DOTNET_ROOT=/usr/share/dotnet \
    PATH="/usr/share/dotnet:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      gnupg \
      git \
      iproute2 \
      sudo \
      fuse-overlayfs \
      libicu-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Docker Engine + Compose v2 plugin from Docker's official apt repo.
# ubuntu:26.04 is too new for Docker's repo to list its own codename yet, so
# the repo is pinned to noble (24.04) — the packages are compatible, this is
# a standard workaround for brand-new Ubuntu releases.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" \
      > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends \
      docker-ce \
      docker-ce-cli \
      containerd.io \
      docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# Install the .NET SDK via Microsoft's install script rather than apt, since
# apt repos won't reliably have .NET 10 packaged for a brand-new Ubuntu
# release yet.
RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && bash /tmp/dotnet-install.sh --channel "${DOTNET_CHANNEL}" --install-dir "${DOTNET_ROOT}" \
    && rm /tmp/dotnet-install.sh

RUN git clone --branch "${GIT_REF}" --depth 1 \
      https://github.com/aatrisgn/TGC.Framework.git /repo

# Throwaway default .env for the compose stack — this container/stack is
# ephemeral and never exposed, so a static dummy password is fine.
RUN { \
      echo "ACCEPT_EULA=Y"; \
      echo "MSSQL_SA_PASSWORD=Tgc-Emulators-Dind-$(date +%s)!"; \
    } > /repo/src/Emulators/docker/.env

COPY dind-entrypoint.sh /usr/local/bin/dind-entrypoint.sh
RUN chmod +x /usr/local/bin/dind-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/dind-entrypoint.sh"]
